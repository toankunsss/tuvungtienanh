{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Success – vocabulary of one grade",
  "type": "object",
  "required": ["grade", "series", "book_title", "publisher", "units"],
  "properties": {
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "series": { "const": "Global Success" },
    "book_title": { "type": "string" },
    "publisher": { "type": "string" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "title", "title_vi", "status", "sources", "words"],
        "properties": {
          "unit": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "title_vi": { "type": "string" },
          "status": {
            "enum": ["sourced", "unverified"],
            "description": "sourced: word list confirmed by the listed sources; unverified: draft not yet checked against sources"
          },
          "sources": { "type": "array", "items": { "type": "string" } },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["word", "pos", "ipa_uk", "ipa_us", "meaning"],
              "additionalProperties": false,
              "properties": {
                "word": { "type": "string" },
                "pos": {
                  "enum": ["n", "v", "adj", "adv", "prep", "conj", "pron", "det", "num",
                           "exclam", "phr", "phr v", "idiom", "modal v", "aux v"]
                },
                "ipa_uk": { "type": "string", "pattern": "^/[^/]+/$", "description": "British IPA (Cambridge/Oxford UK style)" },
                "ipa_us": { "type": "string", "pattern": "^/[^/]+/$", "description": "American IPA (Cambridge US style, from CMU dict)" },
                "audio_uk": { "type": "string", "description": "Relative path to British-accent MP3" },
                "audio_us": { "type": "string", "description": "Relative path to American-accent MP3" },
                "meaning": { "type": "string" },
                "example": { "type": "string" },
                "example_vi": { "type": "string", "description": "Vietnamese translation of example" }
              }
            }
          }
        }
      }
    }
  }
}
